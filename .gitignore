# ---- secrets & local config ----
server/.env
infra/.env
infra/endpoint.json
android/local.properties
android/key.properties
*.jks

# ---- build output ----
server/dist/
android/app/build/
android/build/
android/.gradle/
android/.cxx/
node_modules/
audit/node_modules

# ---- runtime state & logs ----
storage/
logs/
*.log
