[Unit]
Description=FRIDAY One Cloudflare Tunnel
Documentation=file:/home/ubuntu/friday-one/docs/DEPLOY.md
After=friday-one-api.service network-online.target
Wants=network-online.target
# The tunnel is useless without the API behind it.
Requires=friday-one-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/friday-one
ExecStart=/home/ubuntu/friday-one/scripts/tunnel.sh
Restart=on-failure
RestartSec=5

# --- Hardening (matches friday-console.service pattern) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# cloudflared needs no writable paths on disk for a quick tunnel.
# For a named tunnel it writes a cert to ~/.cloudflared — add that to
# ReadWritePaths when migrating to permanent tunnels.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target

</content>