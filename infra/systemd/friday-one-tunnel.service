[Unit]
Description=FRIDAY One Cloudflare Tunnel
Documentation=file:/home/ubuntu/friday-one/docs/DEPLOY.md
After=friday-one-api.service network-online.target
Wants=network-online.target
# The tunnel is useless without the API behind it.
Requires=friday-one-api.service

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/friday-one
ExecStart=/home/ubuntu/friday-one/scripts/tunnel.sh
Restart=on-failure
RestartSec=5

# --- Hardening (matches friday-console.service pattern) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
# The ONLY writable path: where tunnel.sh records the assigned quick-tunnel
# hostname for friday-endpoint-publisher.service to publish to the gist.
# (ProtectSystem=strict makes everything else read-only; /tmp is not usable
# here once PrivateTmp isolates it.)
ReadWritePaths=/home/ubuntu/friday-one/logs
# For a named tunnel cloudflared writes a cert to ~/.cloudflared — add that
# to ReadWritePaths when migrating to permanent tunnels.
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
