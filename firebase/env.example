# FRIDAY One — environment configuration (PLACEHOLDERS ONLY).
# Copy per environment; never commit real values. Secrets are NOT set here:
# they live in Secret Manager (functions) or the Cloud Run secret mounts
# (gateway). See docs/ENVIRONMENT_CONFIGURATION.md.

# ---- Firebase project per environment (also in firebase/.firebaserc) ----
FIREBASE_PROJECT_DEV=friday-969ea
FIREBASE_PROJECT_STAGING=REPLACE-friday-one-staging
FIREBASE_PROJECT_PROD=REPLACE-friday-one-prod
FIREBASE_REGION=REPLACE-region            # decision D4, e.g. asia-south1 (permanent for Firestore)

# ---- functions/ (the /api/v1 port) — non-secret params ----
API_RL_ENROLL_CREATE_PER_HOUR=10
API_RL_CLAIM_PER_10MIN=20
API_RL_CLAIM_FAIL_PER_10MIN=5
API_RL_SESSION_OPEN_PER_HOUR=20
API_RL_SESSION_POLL_PER_MIN=60
API_RL_REVOKE_PER_HOUR=20

# ---- gateway/ ----
PORT=8790
GOOGLE_CLOUD_PROJECT=REPLACE-project-id   # Firestore + ID-token audience
CONNECTOR_IDLE_MS=90000
# Credentials: Cloud Run runtime service account (no key file). On a VM, use
# GOOGLE_APPLICATION_CREDENTIALS pointing at a 0600 file OUTSIDE the repo.

# ---- connector/ (per VPS, /etc/friday-connector/env) ----
FRIDAY_CONTROL_PLANE_URL=https://REPLACE-region-REPLACE-project.cloudfunctions.net/api
FRIDAY_GATEWAY_URL=wss://REPLACE-gateway.run.app
FRIDAY_ALLOWED_ROOTS=/srv/app

# ---- android/ (gradle -P properties or ~/.gradle/gradle.properties) ----
# google-services.json per variant: android/app/src/debug/ and src/release/
CONTROL_PLANE_URL=https://REPLACE/api
GATEWAY_URL=wss://REPLACE.run.app
