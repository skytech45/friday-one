<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all styling; the platform theme only needs to keep the
         system from drawing its own action bar behind our content. -->
    <style name="Theme.FridayOne" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#08090B</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
