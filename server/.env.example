# FRIDAY One — server configuration
#
# Copy to server/.env and fill in the values. Keep server/.env at mode 0600;
# it is gitignored and holds the signing key and the database password.
#
#   cp server/.env.example server/.env && chmod 600 server/.env
#
# Every variable below is read by server/src/config.ts. The three secrets
# (DATABASE_URL, JWT_SECRET, FINGERPRINT_PEPPER) are captured at startup and
# then DELETED from process.env, so they are never inherited by a spawned
# child process (audit finding F-10).

# ---------------------------------------------------------------------------
# REQUIRED — the server refuses to start without these
# ---------------------------------------------------------------------------

# Postgres connection string. The role should NOT be a superuser: give it
# only CONNECT/USAGE/SELECT/INSERT/UPDATE/DELETE on the friday database
# (audit finding F-09).
DATABASE_URL=postgres://friday:CHANGE_ME@127.0.0.1:5433/friday

# The key that signs every access token. Anyone who has it can mint a token
# for any user and device, so it must be long and random. Generate with:
#   openssl rand -hex 32
# Rotating this invalidates every outstanding access token.
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Server-side pepper for device fingerprints. Without it, stored fingerprints
# could be pre-computed and forged, so a new device could be spoofed.
FINGERPRINT_PEPPER=CHANGE_ME_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# ADDRESSING
# ---------------------------------------------------------------------------

# The API must stay on loopback. The Cloudflare tunnel is what exposes it;
# a public bind would put the API directly on the internet.
HOST=127.0.0.1
PORT=8788

# ---------------------------------------------------------------------------
# ACCESS CONTROL
# ---------------------------------------------------------------------------

# Comma-separated list of emails permitted to register. THIS MUST NOT BE
# EMPTY. When it is empty, registration fails closed with HTTP 503 — an
# anonymous caller can never create a trusted device (audit finding F-04).
ALLOWED_EMAILS=owner@example.com

# ---------------------------------------------------------------------------
# FILESYSTEM
# ---------------------------------------------------------------------------

# Directories the file browser may read and write. Keep this narrow: it is
# the only thing standing between an authenticated session and the owner's
# files. Use a dedicated directory, not $HOME (audit finding F-02).
# Comma-separated for multiple roots.
FS_ROOTS=/home/ubuntu/friday-one/storage

# Where uploaded files are indexed from (must be inside FS_ROOTS).
STORAGE_DIR=/home/ubuntu/friday-one/storage

# Working directory — and the child's HOME — for terminal sessions.
# Point this at a dedicated directory so the terminal does not run in the
# owner's home, where .hermes (agent credentials) and .ssh live.
TERMINAL_CWD=/home/ubuntu/friday-one/storage/terminal

# ---------------------------------------------------------------------------
# LIMITS
# ---------------------------------------------------------------------------

# Per-minute request cap, bucketed per client IP.
RATE_LIMIT_MAX=120

# Per-IP login attempts within the 15-minute window.
LOGIN_IP_MAX=10

# Wrong passwords before the account locks. The lockout escalates
# (1m -> 5m -> 15m -> 60m -> 24h) and is stored in Postgres, so it survives
# a restart. Note it also locks the OWNER out — set this high enough to
# tolerate a fat-finger but low enough to slow a brute force.
LOGIN_MAX_FAILURES=5

MAX_UPLOAD_BYTES=209715200
MAX_DOWNLOAD_BYTES=524288000

# ---------------------------------------------------------------------------
# MISC
# ---------------------------------------------------------------------------

# Comma-separated CORS allowlist. Leave empty for a non-browser API; never
# set it to *.
CORS_ORIGINS=

LOG_LEVEL=info
APP_VERSION=0.1.0

# ---------------------------------------------------------------------------
# NOT SET IN .env — read directly from the environment when needed
# ---------------------------------------------------------------------------

# Used only by `npm run migrate` and `npm run seed`:
#   FRIDAY_OWNER_EMAIL=... FRIDAY_OWNER_PASSWORD=... npx tsx src/seed-owner.ts
# The password must be at least 12 characters. It is never written to disk.
#
# Set these only for the duration of the command, e.g.:
#   FRIDAY_OWNER_EMAIL=owner@example.com \
#   FRIDAY_OWNER_PASSWORD='a-long-passphrase' npm run seed
FRIDAY_OWNER_EMAIL=
FRIDAY_OWNER_PASSWORD=

# Bootstrap database role: used ONLY by migrate.ts, which runs as a separate
# process before the server starts. It needs CREATE/ALTER on the schema, so it
# must not be the role the server itself connects with (F-09). Point
# DATABASE_URL at a least-privilege role (DML only); see
# infra/setup-app-role.sh, which creates it and applies the grants.
# MIGRATE_DATABASE_URL=postgres://friday:...@127.0.0.1:5433/friday
